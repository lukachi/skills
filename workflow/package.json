{
  "name": "wfctl",
  "version": "0.9.0",
  "private": false,
  "license": "MIT",
  "description": "Deterministic project workflow bootstrap and lifecycle CLI",
  "type": "module",
  "bin": {
    "wfctl": "dist/cli.js"
  },
  "files": [
    "README.md",
    "IDEA.md",
    "THIRD_PARTY.md",
    "spec",
    "dist",
    "evals",
    "templates",
    "vendor"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/test.mjs",
    "check": "bun run typecheck && bun run test && bun run test:evals && bun run build",
    "test:evals": "bun scripts/eval.mjs",
    "test:graphify": "bun tests/graphify-integration.mjs"
  },
  "packageManager": "bun@1.3.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cliffy/command": "npm:@jsr/cliffy__command@1.2.1",
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@jsr/std__fmt": "1.0.10",
    "mdast-util-from-markdown": "2.0.3",
    "ora": "9.0.0",
    "skills": "1.5.20"
  }
}
